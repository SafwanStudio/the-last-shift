{
  "name": "the-last-shift",
  "version": "0.1.0",
  "description": "The Last Shift - psychological horror desktop thriller",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lastshift.game",
    "productName": "TheLastShift",
    "files": [
      "main.js",
      "index.html",
      "icon.ico"
    ],
    "win": {
      "target": "portable",
      "artifactName": "TheLastShift-${version}.exe",
      "icon": "icon.ico"
    }
  }
}